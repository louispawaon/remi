# TMDB v4 read access token. Server-only: declared in src/env.ts, read from $app/env/private.
TMDB_READ_ACCESS_TOKEN=

# TheGamesDB public API key. Server-only: declared in src/env.ts, read from $app/env/private.
THEGAMESDB_API_KEY=

# Podcast Index API key and secret. Server-only: declared in src/env.ts, read from $app/env/private.
# Quote values that contain # or spaces, e.g. PODCASTINDEX_API_SECRET="abc#def".
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
